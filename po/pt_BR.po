#: prefs.js:30
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:34
msgid "History Items"
msgstr "Itens no histórico"

#: prefs.js:35
msgid "How many copies to keep (most recent first)"
msgstr "Quantas cópias manter (mais recentes primeiro)"

#: prefs.js:47
msgid "Show Icon in the Top Bar"
msgstr "Mostrar ícone na barra superior"

#: prefs.js:48
msgid "Open the history by clicking the icon, in addition to the shortcut"
msgstr "Abrir o histórico clicando no ícone, além do atalho"

#: prefs.js:54
msgid "Detect Content Type"
msgstr "Detectar tipo de conteúdo"

#: prefs.js:55
msgid "Recognize links, colors and emails, and offer quick actions"
msgstr "Reconhecer links, cores e e-mails, e oferecer ações rápidas"

#: prefs.js:61
msgid "Order by Recent Use"
msgstr "Ordenar por uso recente"

#: prefs.js:62
msgid "Show recently used items first"
msgstr "Mostrar primeiro os itens usados recentemente"

#: prefs.js:68
msgid "Trim Whitespace"
msgstr "Aparar espaços em branco"

#: prefs.js:69
msgid "Remove leading and trailing spaces and line breaks"
msgstr "Remover espaços e quebras de linha no início e no fim"

#: prefs.js:75
msgid "Keep History Across Sessions"
msgstr "Manter histórico entre sessões"

#: prefs.js:76
msgid "When off, the history is wiped at logout and nothing is written to disk"
msgstr ""
"Quando desligado, o histórico é apagado ao sair da sessão e nada é gravado "
"em disco"

#: prefs.js:83
msgid "Privacy"
msgstr "Privacidade"

#: prefs.js:84
msgid "Control what gets captured into the history."
msgstr "Controle o que é capturado no histórico."

#: prefs.js:89 lib/quickToggle.js:20
msgid "Private Mode"
msgstr "Modo privado"

#: prefs.js:89
msgid "Pause capturing new items"
msgstr "Pausar a captura de novos itens"

#: prefs.js:90
msgid "Capture Images"
msgstr "Capturar imagens"

#: prefs.js:90
msgid "Store copied images (PNG) in the history"
msgstr "Guardar imagens copiadas (PNG) no histórico"

#: prefs.js:91
msgid "Capture the Primary Selection"
msgstr "Capturar a seleção primária"

#: prefs.js:91
msgid "Also store text selected with the mouse (middle-click)"
msgstr "Também guardar texto selecionado com o mouse (clique do meio)"

#: prefs.js:101
msgid "Excluded Applications"
msgstr "Aplicativos excluídos"

#: prefs.js:102
msgid ""
"Copies made while one of these apps is focused are not stored. Use its app "
"id or window class, e.g. org.keepassxc.KeePassXC."
msgstr ""
"Cópias feitas com um destes apps em foco não são guardadas. Use o id do app "
"ou a classe da janela, ex.: org.keepassxc.KeePassXC."

#: prefs.js:106
msgid "Add an App ID…"
msgstr "Adicionar um ID de app…"

#: prefs.js:155
msgid "Shortcuts"
msgstr "Atalhos"

#: prefs.js:156
msgid ""
"Click a row to set its shortcut; Backspace clears; Esc cancels. All "
"shortcuts are unset by default; if you choose Super+V, Clippo takes it from "
"the message tray (Super+M keeps working)."
msgstr ""
"Clique numa linha para definir o atalho; Backspace limpa; Esc cancela. Todos "
"os atalhos vêm sem definição; se você escolher o Super+V, o Clippo o assume "
"da bandeja de mensagens (o Super+M continua funcionando)."

#: prefs.js:161
msgid "Open History"
msgstr "Abrir histórico"

#: prefs.js:161
msgid "Open the history popup"
msgstr "Abrir a janela do histórico"

#: prefs.js:163
msgid "Paste Next Item"
msgstr "Colar próximo item"

#: prefs.js:163
msgid "Switch the clipboard to the next history item"
msgstr "Mudar a área de transferência para o próximo item do histórico"

#: prefs.js:165
msgid "Paste Previous Item"
msgstr "Colar item anterior"

#: prefs.js:165
msgid "Switch the clipboard to the previous history item"
msgstr "Mudar a área de transferência para o item anterior do histórico"

#: prefs.js:172
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:188
msgid "New Shortcut"
msgstr "Novo atalho"

#: prefs.js:193
msgid ""
"Press the new key combination…\n"
"\n"
"Backspace to clear · Esc to cancel"
msgstr ""
"Pressione a nova combinação de teclas…\n"
"\n"
"Backspace para limpar · Esc para cancelar"

#: lib/clipboardPopup.js:101
msgid "Search…"
msgstr "Buscar…"

#: lib/clipboardPopup.js:118
msgid "Show pinned only"
msgstr "Mostrar só os fixados"

#: lib/clipboardPopup.js:128
msgid "Clear history"
msgstr "Limpar histórico"

#: lib/clipboardPopup.js:188
msgid "No items in history"
msgstr "Nenhum item no histórico"

#: lib/clipboardPopup.js:203
msgid "No matching items"
msgstr "Nenhum item encontrado"

#: lib/clipboardPopup.js:217 lib/clipboardPopup.js:321 lib/cycleOsd.js:72
msgid "Image"
msgstr "Imagem"

#: lib/clipboardPopup.js:248
msgid "Send email"
msgstr "Enviar e-mail"

#: lib/clipboardPopup.js:248
msgid "Open link"
msgstr "Abrir link"

#: lib/clipboardPopup.js:257
msgid "More actions"
msgstr "Mais ações"

#: lib/clipboardPopup.js:268
msgid "Unpin"
msgstr "Desafixar"

#: lib/clipboardPopup.js:268
msgid "Pin"
msgstr "Fixar"

#: lib/clipboardPopup.js:321 lib/cycleOsd.js:72
#, javascript-format
msgid "Image %s"
msgstr "Imagem %s"

#: lib/clipboardPopup.js:352
msgid "just now"
msgstr "agora mesmo"

#: lib/clipboardPopup.js:355
#, javascript-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "há %d minuto"
msgstr[1] "há %d minutos"

#: lib/clipboardPopup.js:358
#, javascript-format
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "há %d hora"
msgstr[1] "há %d horas"

#: lib/clipboardPopup.js:361
#, javascript-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "há %d dia"
msgstr[1] "há %d dias"

#: lib/clipboardPopup.js:378
msgid "Back"
msgstr "Voltar"

#: lib/clipboardPopup.js:412
msgid "Item"
msgstr "Item"

#: lib/clipboardPopup.js:442 lib/clipboardPopup.js:574
msgid "Edit"
msgstr "Editar"

#: lib/clipboardPopup.js:444 lib/clipboardPopup.js:606
msgid "QR Code"
msgstr "Código QR"

#: lib/clipboardPopup.js:447
msgid "Open"
msgstr "Abrir"

#: lib/clipboardPopup.js:448
msgid "Open With…"
msgstr "Abrir com…"

#: lib/clipboardPopup.js:451 lib/clipboardPopup.js:554
msgid "Remove"
msgstr "Remover"

#: lib/clipboardPopup.js:471
msgid "Open With"
msgstr "Abrir com"

#: lib/clipboardPopup.js:482
msgid "No application available"
msgstr "Nenhum aplicativo disponível"

#: lib/clipboardPopup.js:544
msgid "Remove Pinned Item?"
msgstr "Remover item fixado?"

#: lib/clipboardPopup.js:548
msgid "This item is pinned. Remove it from the history anyway?"
msgstr "Este item está fixado. Remover do histórico mesmo assim?"

#: lib/clipboardPopup.js:559 lib/clipboardPopup.js:591
msgid "Cancel"
msgstr "Cancelar"

#: lib/clipboardPopup.js:585
msgid "Save"
msgstr "Salvar"

#: lib/indicator.js:18
msgid "Clipboard history"
msgstr "Histórico da área de transferência"

#: lib/quickToggle.js:21
msgid "Pause clipboard history"
msgstr "Pausar o histórico da área de transferência"
